{
  "schemaVersion": 1,
  "name": "健身日志",
  "columns": [
    { "id": "date", "name": "日期", "type": "date" },
    { "id": "exercise", "name": "动作", "type": "text" },
    { "id": "sets", "name": "组数", "type": "number" },
    { "id": "weight", "name": "重量", "type": "number" }
  ],
  "views": [
    {
      "id": "log",
      "name": "训练记录",
      "order": 0,
      "config": {
        "type": "table",
        "sorts": [{ "columnId": "date", "direction": "desc" }],
        "columnAggregations": { "sets": "sum", "weight": "max" }
      }
    },
    {
      "id": "progress",
      "name": "进展",
      "order": 1,
      "config": {
        "type": "chart",
        "charts": [
          {
            "id": "max-weight",
            "name": "各动作最大重量（kg）",
            "chartType": "bar",
            "dimensionColumnId": "exercise",
            "valueColumnIds": ["weight"],
            "aggregation": "max",
            "colSpan": 2,
            "rowSpan": 1
          },
          {
            "id": "volume-by-day",
            "name": "每日总组数",
            "chartType": "line",
            "dimensionColumnId": "date",
            "dateBucket": "day",
            "valueColumnIds": ["sets"],
            "aggregation": "sum",
            "colSpan": 2,
            "rowSpan": 1
          }
        ]
      }
    }
  ],
  "rows": [
